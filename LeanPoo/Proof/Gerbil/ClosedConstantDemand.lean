import Std

namespace LeanPoo.Proof.Gerbil.ClosedConstantDemand

/-- Stored per-slot methods can execute author code. The constant arm is a
closure generated by the same preparation that installed the methods. -/
inductive SlotMethod (State Error Read Value : Type) where
  | constant (value : Value)
  | callback (apply : State → Except Error (Value × List Read × State))

def SlotMethod.run : SlotMethod State Error Read Value →
    State → Except Error (Value × List Read × State)
  | .constant value, state => .ok (value, [], state)
  | .callback apply, state => apply state

/-- Only an empty active slot stack and a current native lookup can expose
the identity of the just-compiled constant. Rejection feeds the original
lookup, cycle check and recorder with the same post-preparation state. -/
theorem guarded_constant_demand
    (ordinary : State → Except Error (Value × List Read × State))
    (candidate : State → Option Value)
    (certified : ∀ state value, candidate state = some value →
      ordinary state = (SlotMethod.constant (Error := Error) (Read := Read) value).run state)
    (prepare : State → Except Error State)
    (publish : Value → List Read → State → Except Error Result) (initial : State) :
    (prepare initial >>= fun state =>
      (match candidate state with
      | some value => .ok (value, [], state)
      | none => ordinary state) >>= fun (value, reads, after) =>
        publish value reads after) =
    (prepare initial >>= fun state =>
      ordinary state >>= fun (value, reads, after) => publish value reads after) := by
  cases setup : prepare initial with
  | error cause => rfl
  | ok state =>
    cases found : candidate state with
    | none => simp [Bind.bind, Except.bind, found]
    | some value =>
      have native := certified state value found
      simp [Bind.bind, Except.bind, found, native, SlotMethod.run]

/-- The identity guard compares the live callable to the constant installed
for this exact demand. Injectivity is over live method objects, not over
equivalent return values. -/
theorem live_constant_method
    (identity : SlotMethod State Error Read Value → Nat)
    (exactIdentity : Function.Injective identity)
    (current : SlotMethod State Error Read Value) (value : Value)
    (same : identity current = identity (.constant value))
    (state : State) :
    current.run state = .ok (value, [], state) := by
  have installed := exactIdentity same
  rw [installed]
  rfl

/-- A changed method identity forces the ordinary read even when the old
token still contains a constant. This also keeps callback errors visible. -/
theorem changed_method_never_uses_constant
    (issued live : Nat) (sameRoute inactive : Bool) (value : Value)
    (changed : issued ≠ live) :
    (if sameRoute && inactive && decide (issued = live) then some value else none) = none := by
  simp [changed]

#print axioms guarded_constant_demand
#print axioms live_constant_method
#print axioms changed_method_never_uses_constant

end LeanPoo.Proof.Gerbil.ClosedConstantDemand
